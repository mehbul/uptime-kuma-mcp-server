{
  "name": "uptime-kuma-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Uptime Kuma monitoring: monitors, heartbeats, status pages and notifications",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "uptime-kuma-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node scripts/run-live-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "uptime-kuma",
    "monitoring",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "express": "^4.19.2",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "socket.io": "~4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
